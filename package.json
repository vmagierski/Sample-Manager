{
  "name": "sample-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Keyboard-driven sample browser with auto-tagging and native drag-to-DAW, for macOS and Windows",
  "license": "UNLICENSED",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "node scripts/electron-node.js --test \"test/*.test.js\"",
    "dist": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "install-app": "electron-builder --mac dir --arm64 && rm -rf \"/Applications/Sample Manager.app\" && ditto \"dist/mac-arm64/Sample Manager.app\" \"/Applications/Sample Manager.app\" && echo Installed to /Applications",
    "bench": "node scripts/electron-node.js scripts/bench.js",
    "bench:make": "node scripts/electron-node.js scripts/make-bench-library.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.victor.sample-manager",
    "productName": "Sample Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "tag-rules.json",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "artifactName": "Sample-Manager-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Sample Manager"
    }
  }
}
